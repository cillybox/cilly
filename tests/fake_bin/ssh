#!/usr/bin/env python3
"""Fake ssh for the SSH tunnel tests.  Fetching the host key (accept-new) writes
FAKE_SSH_HOST_KEY under the alias and fails to log in, as a real server does.  A tunnel checks
the pinned key and its own key file, then forwards 127.0.0.1:PORT to the target, which in the
tests is on this PC too.  FAKE_SSH_DENY=1 refuses the key.  Its argv goes to FAKE_SSH_LOG.
FAKE_SSH_BANNER is a banner the server sends, which ssh shows below LogLevel=ERROR, as real ssh
does.  A forward to a port where nothing listens fails the way ssh reports it, and so does any
forward with FAKE_SSH_PROHIBIT=1, as for a server whose permitopen doesn't match."""
import json
import os
import socket
import sys
import threading

HOST_KEY = os.environ.get("FAKE_SSH_HOST_KEY", "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBERERERERERERERERERERERERERERERERERERERERER")
args, opts, i = sys.argv[1:], {}, 0
forward = key = None
while i < len(args):
    a = args[i]
    if a == "-o":
        k, _, v = args[i + 1].partition("=")
        opts[k] = v
        i += 2
    elif a in ("-L", "-i", "-p", "-F"):
        if a == "-L":
            forward = args[i + 1]
        if a == "-i":
            key = args[i + 1]
        i += 2
    elif a == "--":
        i += 2
    else:
        i += 1
if os.environ.get("FAKE_SSH_LOG"):
    with open(os.environ["FAKE_SSH_LOG"], "a") as f:
        f.write(json.dumps({"argv": sys.argv, "env": dict(os.environ)}) + "\n")
alias, known = opts.get("HostKeyAlias"), opts.get("UserKnownHostsFile")
if os.environ.get("FAKE_SSH_BANNER") and opts.get("LogLevel", "INFO").upper() not in ("ERROR", "FATAL", "QUIET"):
    print(os.environ["FAKE_SSH_BANNER"], file=sys.stderr, flush=True)
if opts.get("StrictHostKeyChecking") == "accept-new":
    with open(known, "a") as f:
        f.write(f"{alias} {HOST_KEY}\n")
    print(f"Warning: Permanently added '{alias}' (ED25519) to the list of known hosts.", file=sys.stderr)
    print("user@host: Permission denied (publickey).", file=sys.stderr)
    sys.exit(255)
with open(known) as f:
    if f"{alias} {HOST_KEY}" not in f.read():
        print("Host key verification failed.", file=sys.stderr)
        sys.exit(255)
if not key or os.stat(key).st_mode & 0o077 or os.environ.get("FAKE_SSH_DENY"):
    print("user@host: Permission denied (publickey).", file=sys.stderr)
    sys.exit(255)
_, port, thost, tport = forward.split(":")  # 127.0.0.1:PORT:HOST:PORT, all IPv4 in the tests
srv = socket.socket()
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    srv.bind(("127.0.0.1", int(port)))
except OSError:
    print(f"bind [127.0.0.1]:{port}: Address already in use", file=sys.stderr)
    print("Could not request local forwarding.", file=sys.stderr)
    sys.exit(255)
srv.listen()
print("listening", flush=True)


def pump(a, b):
    try:
        while data := a.recv(65536):
            b.sendall(data)
    except OSError:
        pass
    finally:
        for s in (a, b):
            try:
                s.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass


channel = 2
while True:
    c, _ = srv.accept()
    channel += 1
    if os.environ.get("FAKE_SSH_PROHIBIT"):
        print(f"channel {channel}: open failed: administratively prohibited: open failed", file=sys.stderr, flush=True)
        c.close()
        continue
    try:
        up = socket.create_connection((thost.strip("[]"), int(tport)))
    except OSError:
        print(f"channel {channel}: open failed: connect failed: Connection refused", file=sys.stderr, flush=True)
        c.close()
        continue
    threading.Thread(target=pump, args=(c, up), daemon=True).start()
    threading.Thread(target=pump, args=(up, c), daemon=True).start()
